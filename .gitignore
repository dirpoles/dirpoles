# Seguridad
.env

# Dependencias (se regeneran)
/vendor/
/node_modules/
# /dist/ — Se removió del .gitignore porque contiene assets manuales (login.js, login.css, etc.)
# Si en el futuro se implementa un build step (webpack/vite), se puede volver a agregar.
/.vscode/

# Archivos generados y temporales
/uploads/*
!/uploads/.gitkeep
/logs/*.log